
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  EMPLOYER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OpportunityCategory {
  INTERNSHIP
  FULL_TIME_JOB
  PART_TIME_JOB
  FREELANCE
  CONTRACT
  RESEARCH
  TRAINING
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  FREELANCE
  INTERNSHIP
}

// ==========================================
// USER
// ==========================================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  company        Company?        @relation("CompanyOwner")
  applications   Application[]
  notifications  Notification[]

  @@map("users")
}

// ==========================================
// STUDENT PROFILE
// ==========================================

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  university     String?
  degree         String?
  branch         String?
  graduationYear Int?
  resumeUrl      String?
  skills         String[]
  linkedinUrl    String?
  portfolioUrl   String?

  hasWorkExperience Boolean @default(false)
  workExperience    Json    @default("[]")

  projects       Json @default("[]")
  certifications Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// ==========================================
// COMPANY
// ==========================================

model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  website     String?
  industry    String?
  location    String?
  logoUrl     String?
  ownerId     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  internships   Internship[]
  opportunities Opportunity[]

  @@map("companies")
}

// ==========================================
// UNIFIED OPPORTUNITY MODEL
// ==========================================

model Opportunity {
  id             String              @id @default(uuid())
  title          String
  description    String
  category       OpportunityCategory
  employmentType EmploymentType?
  location       String?
  isRemote       Boolean             @default(false)
  compensation   String?
  duration       String?
  requirements   String?
  applicationUrl String?
  deadline       DateTime?
  isActive       Boolean             @default(true)
  companyId      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  applications Application[]

  @@index([companyId])
  @@index([isActive])
  @@index([category])
  @@index([employmentType])
  @@index([createdAt])
  @@map("opportunities")
}

// ==========================================
// LEGACY INTERNSHIP MODEL
// ==========================================

model Internship {
  id             String    @id @default(uuid())
  title          String
  description    String
  location       String?
  isRemote       Boolean   @default(false)
  internshipType String?
  stipend        String?
  duration       String?
  requirements   String?
  applicationUrl String?
  deadline       DateTime?
  isActive       Boolean   @default(true)
  companyId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  applications Application[]

  @@index([companyId])
  @@index([isActive])
  @@map("internships")
}

// ==========================================
// APPLICATION
// ==========================================

model Application {
  id            String            @id @default(uuid())
  userId        String
  internshipId  String?
  opportunityId String?
  status        ApplicationStatus @default(PENDING)
  coverLetter   String?
  resumeUrl     String?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  internship Internship? @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  statusHistory ApplicationStatusHistory[]

  @@unique([userId, internshipId])
  @@unique([userId, opportunityId])
  @@index([internshipId])
  @@index([opportunityId])
  @@map("applications")
}

// ==========================================
// APPLICATION STATUS HISTORY
// ==========================================

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  changedByRole UserRole?
  note          String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
